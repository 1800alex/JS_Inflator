FROM ubuntu:20.04 AS builder

# Avoid interactive prompts
ENV DEBIAN_FRONTEND=noninteractive

# Install build dependencies, Kitware APT repo for newer CMake, and GCC 11
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    gpg \
    wget \
    software-properties-common \
    # Add Kitware repo for CMake
    && wget -O - https://apt.kitware.com/keys/kitware-archive-latest.asc 2>/dev/null | gpg --dearmor - | tee /usr/share/keyrings/kitware-archive-keyring.gpg >/dev/null \
    && echo 'deb [signed-by=/usr/share/keyrings/kitware-archive-keyring.gpg] https://apt.kitware.com/ubuntu/ focal main' | tee /etc/apt/sources.list.d/kitware.list >/dev/null \
    # Add toolchain repo for GCC 11
    && add-apt-repository -y ppa:ubuntu-toolchain-r/test \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
    # Build essentials with GCC 11
    build-essential \
    gcc-11 \
    g++-11 \
    cmake \
    git \
    pkg-config \
    # VST3 SDK dependencies
    libstdc++6 \
	libx11-xcb-dev \
	libxcb-util-dev \
	libxcb-cursor-dev \
	libxcb-xkb-dev \
	libxkbcommon-dev \
	libxkbcommon-x11-dev \
	libfontconfig1-dev \
	libcairo2-dev \
	libgtkmm-3.0-dev \
	libsqlite3-dev \
	libxcb-keysyms1-dev \
    # Set GCC 11 as default
    && update-alternatives --install /usr/bin/gcc gcc /usr/bin/gcc-11 110 \
    && update-alternatives --install /usr/bin/g++ g++ /usr/bin/g++-11 110 \
    # Clean up
    && rm -rf /var/lib/apt/lists/*

# Set working directory
WORKDIR /build

# Copy source files
COPY libs/ libs/
COPY resource/ resource/
COPY CMakeLists.txt .
COPY Makefile .
COPY source/ source/

# Configure and build with cached dependencies
# The --mount=type=cache keeps the CMake build cache (_deps) between builds
ARG NOCACHE=0
RUN --mount=type=cache,id=jsinflator-ubuntu2004-deps,target=/build/build/_deps \
    --mount=type=cache,id=jsinflator-ubuntu2004-cache,target=/root/.cache \
    if [ "$NOCACHE" = "1" ]; then rm -rf /build/build/_deps/*; fi && \
    cmake -B build \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_EXPORT_COMPILE_COMMANDS=ON \
        -DFETCHCONTENT_QUIET=OFF \
    && cmake --build build --config Release --parallel $(nproc)

# Create output stage
FROM scratch AS export

# Copy built artifacts
COPY --from=builder /build/build/VST3/Release/JS_Inflator.vst3/ /vst3/

# Default entrypoint copies files to mounted volume
FROM ubuntu:20.04 AS runtime

COPY --from=builder /build/build/VST3/Release/JS_Inflator.vst3/ /vst3/JS_Inflator.vst3/

# Script to copy artifacts to output volume
RUN echo '#!/bin/bash\n\
echo "Copying VST3 plugin..."\n\
cp -rv /vst3/* /out/ 2>/dev/null || true\n\
echo "Done! Files copied to /out/"\n\
ls -la /out/\n\
' > /copy-artifacts.sh && chmod +x /copy-artifacts.sh

ENTRYPOINT ["/copy-artifacts.sh"]
